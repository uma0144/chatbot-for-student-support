# ======================================================
# Student Support Chatbot Configuration
# Copy this file to .env and fill in your values:
#   cp .env.example .env
# ======================================================

# -------------------------------
# Groq API Configuration (REQUIRED for chat)
# -------------------------------
GROQ_API_KEY=
LLM_MODEL=openai/gpt-oss-120b
TEMPERATURE=0.2

# -------------------------------
# Embedding Model (HuggingFace)
# -------------------------------
MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
# Optional — faster downloads, fewer HF Hub warnings
# Create free token: https://huggingface.co/settings/tokens
HF_TOKEN=

# -------------------------------
# Vector Database
# -------------------------------
VECTOR_DB=faiss
FAISS_PATH=storage/vector_db

# -------------------------------
# Knowledge Base
# -------------------------------
DATA_PATH=knowledge-base

# -------------------------------
# Text Splitter
# -------------------------------
CHUNK_SIZE=500
CHUNK_OVERLAP=100

# -------------------------------
# FastAPI Server (Docker uses 8000)
# -------------------------------
HOST=0.0.0.0
PORT=8000

# -------------------------------
# Database (Docker overrides via compose)
# -------------------------------
DATABASE_URL=sqlite:///student_chatbot.db

# -------------------------------
# Authentication — change SECRET_KEY in production
# -------------------------------
SECRET_KEY=change-this-to-a-long-random-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

FRONTEND_URL=http://localhost:5173

# Public deployment — comma-separated frontend URL(s) for CORS
# Example: https://your-app.vercel.app
# Vercel preview URLs are also allowed via CORS_ALLOW_VERCEL (default true)
CORS_ORIGINS=
ALLOWED_ORIGINS=
CORS_ALLOW_VERCEL=true

# -------------------------------
# Email notifications (optional — ticket alerts)
# -------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SUPPORT_EMAIL=admission@itmuniversity.ac.in
