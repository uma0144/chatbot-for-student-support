# ======================================================
# Student Support Chatbot Configuration
# Copy this file to .env and fill in your values:
#   cp .env.example .env
# ======================================================

# -------------------------------
# Groq API Configuration (REQUIRED for chat)
# -------------------------------
GROQ_API_KEY=
LLM_MODEL=llama-3.3-70b-versatile
TEMPERATURE=0.2

# -------------------------------
# Embedding Model
# -------------------------------
MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2

# -------------------------------
# Vector Database
# -------------------------------
VECTOR_DB=faiss
FAISS_PATH=storage/vector_db

# -------------------------------
# Knowledge Base
# -------------------------------
DATA_PATH=knowledge-base

# -------------------------------
# Text Splitter
# -------------------------------
CHUNK_SIZE=500
CHUNK_OVERLAP=100

# -------------------------------
# FastAPI Server (Docker uses 8000)
# -------------------------------
HOST=0.0.0.0
PORT=8000

# -------------------------------
# Database (Docker overrides via compose)
# -------------------------------
DATABASE_URL=sqlite:///student_chatbot.db

# -------------------------------
# Authentication — change SECRET_KEY in production
# -------------------------------
SECRET_KEY=change-this-to-a-long-random-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

FRONTEND_URL=http://localhost:5173

# Public deployment — add your live site URL(s), comma-separated
# Example: CORS_ORIGINS=https://support.itmuniversity.ac.in,http://203.0.113.50:5173
CORS_ORIGINS=
