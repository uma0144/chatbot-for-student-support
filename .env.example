# ======================================================
# Student Support Chatbot Configuration
# Copy this file to .env and fill in your values:
#   cp .env.example .env
# ======================================================

# -------------------------------
# Groq API Configuration
# -------------------------------
GROQ_API_KEY=
LLM_MODEL=llama-3.3-70b-versatile
TEMPERATURE=0.2

# -------------------------------
# Embedding Model
# -------------------------------
MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2

# -------------------------------
# Vector Database
# -------------------------------
VECTOR_DB=faiss
FAISS_PATH=storage/vector_db

# -------------------------------
# Knowledge Base
# -------------------------------
DATA_PATH=knowledge-base

# -------------------------------
# Text Splitter
# -------------------------------
CHUNK_SIZE=500
CHUNK_OVERLAP=100

# -------------------------------
# FastAPI Server
# -------------------------------
HOST=127.0.0.1
PORT=8000

# -------------------------------
# Database
# -------------------------------
DATABASE_URL=sqlite:///student_chatbot.db

# -------------------------------
# Authentication
# -------------------------------
SECRET_KEY=your_secret_key_here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

FRONTEND_URL=http://localhost:5173

# -------------------------------
# Docker (optional)
# -------------------------------
# VITE_API_BASE_URL=http://localhost:8000
