# Backend URL for local development.
# PowerShell (use UTF-8 — do NOT use: echo ... > .env.local)
#   Set-Content -Path .env.local -Value "VITE_API_BASE_URL=http://127.0.0.1:8081" -Encoding utf8NoBOM
#
# If unset, Vite proxies /api to http://127.0.0.1:8081 (see vite.config.js).
VITE_API_BASE_URL=http://127.0.0.1:8081
