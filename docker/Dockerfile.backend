FROM ghcr.io/astral-sh/uv:python3.14-bookworm-slim

WORKDIR /app

RUN apt-get update \
    && apt-get install -y --no-install-recommends git curl \
    && rm -rf /var/lib/apt/lists/*

COPY pyproject.toml uv.lock ./
COPY docker/filter_requirements.py docker/install-backend-deps.sh /docker/

RUN chmod +x /docker/install-backend-deps.sh \
    && /docker/install-backend-deps.sh

COPY backend ./backend
COPY ai_engine ./ai_engine
COPY config ./config
COPY knowledge-base ./knowledge-base
COPY scripts ./scripts

RUN mkdir -p storage/vector_db data

# Bake FAISS index into the image (faster cold starts on cloud deploy)
RUN uv run python .cursor/scripts/build_vectorstore.py

COPY docker/backend-entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh

ENV PYTHONUNBUFFERED=1 \
    PATH="/app/.venv/bin:$PATH" \
    PORT=8000 \
    DATABASE_URL=sqlite:///data/student_chatbot.db \
    FAISS_PATH=storage/vector_db \
    DATA_PATH=knowledge-base \
    HF_HOME=/app/.cache/huggingface

EXPOSE 8000

ENTRYPOINT ["/entrypoint.sh"]
