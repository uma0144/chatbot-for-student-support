FROM ghcr.io/astral-sh/uv:python3.14-bookworm-slim

WORKDIR /app

RUN apt-get update \
    && apt-get install -y --no-install-recommends git curl \
    && rm -rf /var/lib/apt/lists/*

COPY pyproject.toml uv.lock ./

# Create venv first — uv pip/sync require it in the slim image
ENV UV_LINK_MODE=copy
RUN uv venv /app/.venv
ENV PATH="/app/.venv/bin:$PATH"

# CPU torch FIRST (~180MB), then sync other deps without re-installing CUDA torch from PyPI
RUN uv pip install torch --index-url https://download.pytorch.org/whl/cpu \
    && uv sync --frozen --no-dev --no-install-package torch

COPY backend ./backend
COPY ai_engine ./ai_engine
COPY config ./config
COPY knowledge-base ./knowledge-base
COPY scripts ./scripts

RUN mkdir -p storage/vector_db data

COPY docker/backend-entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh

ENV PYTHONUNBUFFERED=1 \
    PORT=8000 \
    DATABASE_URL=sqlite:///data/student_chatbot.db \
    FAISS_PATH=storage/vector_db \
    DATA_PATH=knowledge-base \
    HF_HOME=/app/.cache/huggingface

EXPOSE 8000

ENTRYPOINT ["/entrypoint.sh"]
